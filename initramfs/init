#!/bin/busybox sh
# =============================================================================
# /init — Initramfs mínimo para Arch Linux ARM en begonia
# =============================================================================
# Busca rootfs por label, UUID o partición; hace switch_root a systemd
# =============================================================================

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export SHELL=/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

echo "[arch-begonia-initramfs] mounting required filesystems"
mkdir -p /dev/pts /dev/shm /run
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run

NEWROOT=/newroot
mkdir -p $NEWROOT

echo "[arch-begonia-initramfs] searching for rootfs..."

# Estrategia de búsqueda por orden de preferencia
ROOT_FOUND=""

# 1. Label ArchRoot (arch rootfs)
if [ -z "$ROOT_FOUND" ] && [ -b /dev/disk/by-label/ArchRoot ]; then
    echo "[arch-begonia-initramfs] found by label: ArchRoot"
    mount -t ext4 /dev/disk/by-label/ArchRoot $NEWROOT 2>/dev/null && ROOT_FOUND="ArchRoot"
fi

# 2. Label pmOS_root (compatibilidad con pmOS initramfs)
if [ -z "$ROOT_FOUND" ] && [ -b /dev/disk/by-label/pmOS_root ]; then
    echo "[arch-begonia-initramfs] found by label: pmOS_root"
    mount -t ext4 /dev/disk/by-label/pmOS_root $NEWROOT 2>/dev/null && ROOT_FOUND="pmOS_root"
fi

# 3. UUID específico (se inyecta en build time)
if [ -z "$ROOT_FOUND" ] && [ -n "$ROOT_UUID" ]; then
    echo "[arch-begonia-initramfs] trying UUID: $ROOT_UUID"
    mount -t ext4 UUID=$ROOT_UUID $NEWROOT 2>/dev/null && ROOT_FOUND="UUID"
fi

# 4. Partición userdata (instalación directa en Android)
if [ -z "$ROOT_FOUND" ] && [ -b /dev/block/by-name/userdata ]; then
    echo "[arch-begonia-initramfs] trying userdata partition"
    mount -t ext4 /dev/block/by-name/userdata $NEWROOT 2>/dev/null && ROOT_FOUND="userdata"
fi

# 5. Scaneo genérico de particiones ext4
if [ -z "$ROOT_FOUND" ]; then
    echo "[arch-begonia-initramfs] scanning for ext4 partitions..."
    for part in /dev/block/* /dev/sd* /dev/mmcblk*p* /dev/vd*; do
        [ -b "$part" ] || continue
        mount -t ext4 "$part" $NEWROOT 2>/dev/null || continue
        if [ -x $NEWROOT/sbin/init ] || [ -x $NEWROOT/usr/lib/systemd/systemd ]; then
            echo "[arch-begonia-initramfs] found rootfs on: $part"
            ROOT_FOUND="$part"
            break
        fi
        umount $NEWROOT 2>/dev/null
    done
fi

# Si no se encontró nada, shell de emergencia
if [ ! -x $NEWROOT/sbin/init ] && [ ! -x $NEWROOT/usr/lib/systemd/systemd ]; then
    echo "[arch-begonia-initramfs] ERROR: rootfs not found or invalid"
    echo "[arch-begonia-initramfs] devices available:"
    ls -la /dev/block/ 2>/dev/null || ls -la /dev/ 2>/dev/null || true
    
    echo ""
    echo "[arch-begonia-initramfs] === EMERGENCY SHELL ==="
    echo "[arch-begonia-initramfs] Mount root manually and type 'exit'"
    exec sh
fi

# Limpiar y hacer switch_root
echo "[arch-begonia-initramfs] switching to Arch Linux ARM"
echo "[arch-begonia-initramfs] PID 1 will be: $(ls -la $NEWROOT/sbin/init 2>/dev/null || echo 'systemd')"

exec switch_root $NEWROOT /sbin/init
